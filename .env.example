# ---- DeepSeek----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# ---- 智谱 GLM ----
# GLM 走 OpenAI 兼容接口
GLM_API_KEY=
GLM_BASE_URL=

# ---- 阿里云多模态嵌入模型 ----
ALIBABA_API_KEY=

#通过环境变量 EMBEDDING_BACKEND 切换：
#    - "local" : 使用本地 Alibaba-NLP/gme-Qwen2-VL-2B-Instruct
#    - "cloud" : 使用 DashScope multimodal-embedding-v1
EMBEDDING_BACKEND=local

# ---- Milvus（可选，默认值即下面这行）----
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=t_doc_collection

# ---- 多模态模型本地快照路径（可选）----
# 不填则默认读 ~/.cache/huggingface/hub/models--Qwen--Qwen3-VL-Embedding-2B
QWEN3_VL_EMBEDDING_PATH=
