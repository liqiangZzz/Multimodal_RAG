# =====================================================================
# LangChainEmbedding .gitignore
#
# 原则：只把「源码 + 文档 + 输入数据」推到远端，
#      凡是能由代码重新生成的、或含密钥的、或本地环境相关的，一律不入库。
# =====================================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 虚拟环境 ----------
# 本项目实际用的是 conda 环境 langchain-embedding，不在项目目录内；
# 这里只为防止误提交项目内的 .venv / venv
venv/
.venv/
env/
ENV/
venv.bak/

# ---------- 环境变量 / 密钥（绝不入库）----------
.env
.env.*
# 例外：.env.example 是模板，需要入库（注意 .gitignore 不支持行尾注释，
# 注释必须单独一行，否则整行会被当成文件名模式）
!.env.example

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- macOS 垃圾文件 ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
.AppleDouble

# ---------- 测试 / 静态检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ---------- Python 打包构建产物 ----------
build/
dist/
*.egg-info/
*.egg
.eggs/
sdist/
wheels/
pip-wheel-metadata/
MANIFEST

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- LangGraph dev server 运行时数据 ----------
.langgraph_api/

# ---------- 日志 ----------
*.log
logs/

#---------- 图片 ----------
images/

# ---------- 例外：以下目录必须入库，禁止被任何规则过滤 ----------
# data/  是输入数据（PDF 等），output/ 是解析结果，都需要提交到远端。
# 放在文件末尾，确保后置否定（!）能覆盖前面所有匹配规则。
!data/
!data/**/
!data/**
!output/
!output/**/
!output/**
